# Raw and generated data / 원본 및 생성 데이터
01_raw_data/**/*
!01_raw_data/**/
!01_raw_data/**/.gitkeep
02_outputs/data/**/*
!02_outputs/data/.gitkeep
02_outputs/interim/**/*
!02_outputs/interim/.gitkeep
02_outputs/figures/**/*
!02_outputs/figures/.gitkeep

# Temporary files / 임시 파일
999_Temporary/**/*
!999_Temporary/.gitkeep

# Local dashboard builds / 로컬 대시보드 빌드 산출물
08_dashboard/**/dist/
08_dashboard/**/.data-app-offline/
08_dashboard/**/node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Environments and secrets / 환경 및 비밀정보
.env
.venv/
venv/
env/
config/.env
config/secrets.*
!config/*.json
!config/resource_scenarios/
!config/resource_scenarios/*.json
!tests/fixtures/*.json

# Editors and operating systems / 편집기 및 운영체제
.DS_Store
Thumbs.db
.idea/
.vscode/
