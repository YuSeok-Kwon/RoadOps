# Copy to config/.env and load it in your shell. Never commit real keys.
# config/.env로 복사해 셸에서 불러오세요. 실제 키는 커밋하지 않습니다.

JEJU_CITS_API_KEY=
JEJU_ITS_API_KEY=
DATA_GO_KR_SERVICE_KEY=
TAAS_API_KEY=

# Jeju's pilot AI road-control platform has not published a public API contract.
# Fill these only after the operating agency issues an endpoint and token.
# 제주 AI 도로관제 시범 플랫폼의 운영기관이 주소와 토큰을 발급한 뒤 입력합니다.
JEJU_AI_CONTROL_API_URL=
JEJU_AI_CONTROL_API_TOKEN=

# SGIS official WGS84 reverse geocoding (service ID and security key)
# SGIS 공식 WGS84 역지오코딩 서비스 ID와 보안 Key
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
